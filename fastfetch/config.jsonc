{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "lfs",
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "format": "Linux From Scratch (HappyHappyCore Edition) x86_64"
        },
        {
            "type": "host",
            "format": "Lenovo Thinkpad Yoga 11e"
        },
        {
            "type": "kernel",
            "format": "HappyHappyCore"
        },
        "uptime",
        {
            "type": "packages",
            "format": "Syntax Error (?)"
        },
        "shell",
        "display",
        {
            "type": "wm",
            "format": "Not Hyprland!"
        },
        "terminal",
        "cpu",
        "memory",
        "break",
        "colors",
        "break"
    ]
}
